# ==============================================================
# Sanjay Kirana Store - Backend Environment Variables
# ==============================================================

# Database Connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sanjay_kirana
DB_USER=postgres
DB_PASSWORD=your_database_password_here
DB_SSLMODE=disable

# Authentication
# In production, set this to a cryptographically secure random string:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-strong-random-jwt-secret-key-here

# Server Port (Optional: Render assigns PORT automatically)
PORT=5000

# SMS Provider Configuration
# Set to 'msg91' for production real SMS delivery via MSG91 v5 OTP API.
# Set to 'mock' for local developer testing (only active if ALLOW_MOCK_SMS=true).
SMS_PROVIDER=msg91
ALLOW_MOCK_SMS=false

# MSG91 SMS Gateway Configuration
# Your MSG91 Account AuthKey (required for production SMS and token verification):
MSG91_AUTHKEY=your_msg91_authkey_here

# Optional: DLT OTP Template ID (if you have configured a custom template in MSG91)
# MSG91_TEMPLATE_ID=your_template_id_here
