# ==============================================================
# Sanjay Kirana Store - Frontend Environment Variables
# ==============================================================

# Backend API base URL (Vite requires the VITE_ prefix)
#
# 1. Local Development (Flask running locally):
VITE_API_URL=http://127.0.0.1:5000

# 2. Production / Render Deployment (Replace with your actual Render service URL):
# VITE_API_URL=https://sanjay-kirana-store-backend.onrender.com

# MSG91 OTP Widget Configuration (Client-side)
# Obtain these from your MSG91 Dashboard -> OTP Widget Configuration screen:
VITE_MSG91_WIDGET_ID=your_msg91_widget_id_here
VITE_MSG91_TOKEN_AUTH=your_msg91_client_widget_token_here


